# VideoMAE model source: HuggingFace Hub repo ID (auto-downloaded on first run)
# or a local directory path. Leave unset to use the public repo default in config.py.
# MODEL_PATH="okeh-anthony/videomae-asl-finetuned"
HF_TOKEN ="hf_xx"

# Sentence/chat LLM backend selector:
#   local — run LLM_MODEL_NAME on this machine's GPU/CPU (needs transformers + weights)
#   cloud — call OPENROUTER_MODEL over the OpenRouter API (no local weights)
LLM_BACKEND="cloud"

# --- Local backend settings (used when LLM_BACKEND=local) ---
LLM_MODEL_NAME="Qwen/Qwen3.5-4B"
LLM_DEVICE="auto"
LLM_MAX_LENGTH=100
LLM_TEMPERATURE=0.7
LLM_USE_QUANTIZATION=false
HF_UPLOAD_TOKEN="hf_xx"

# Remote LLM (OpenRouter) — used for sentence/chat generation. This is a REMOTE
# API call; no local model runs on the GPU.
# CAN LOAD EITHER OPENROUTER OR LOCAL IF COMPUTE IS TIGHT FOR CHAT MODEL
OPENROUTER_API_KEY="sk-or-v1-xxx"
LLM_PROVIDER="openrouter"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="google/gemma-4-26b-a4b-it:free"